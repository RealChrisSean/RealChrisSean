# Copy to .env for local runs. In GitHub Actions, set these as repo secrets/vars.

# Brand keywords to watch (comma-separated). Phrases are fine.
KEYWORDS=fly.io,flydotio,sprites.dev,KiloClaw,fly machines

# Opportunity keywords: threads worth showing up in even without a brand
# mention (searched on HN, and within the subreddits below).
TOPICS=copilot alternative,copilot pricing

# ICP subreddits that TOPICS are scoped to.
SUBREDDITS=AI_Agents,LLMDevs,LocalLLaMA,SaaS

# Agent-framework repos that GitHub search is scoped to (owner/name).
GITHUB_REPOS=All-Hands-AI/OpenHands,cline/cline,crewAIInc/crewAI

# Toggle sources (free ones default on). 1/true/yes/on to enable.
SOURCE_HACKERNEWS=true
SOURCE_REDDIT=true
SOURCE_BLUESKY=true
SOURCE_GOOGLENEWS=true
SOURCE_GITHUB=true

# Optional: raises GitHub search rate limit from 10 to 30 req/min.
# GITHUB_TOKEN=

# X / Twitter is OFF by default and needs a PAID API token (Basic tier ~$100/mo).
SOURCE_TWITTER=false
# TWITTER_BEARER_TOKEN=

# Mastodon status search needs an access token (read:search scope). OFF without one.
SOURCE_MASTODON=false
MASTODON_INSTANCE=fosstodon.org
# MASTODON_TOKEN=

# On the first run only, ignore anything older than this many hours so you don't
# get flooded with backlog. After that, dedup handles everything.
LOOKBACK_HOURS=24

# Where to send alerts (optional — console output always works).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
